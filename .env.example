# Copy: cp .env.example .env
# Go loads this via godotenv (OS env wins). Compose also reads it.

# --- Postgres ---
POSTGRES_USER=scheduler
POSTGRES_PASSWORD=scheduler
POSTGRES_DB=scheduler
POSTGRES_PORT=5432

# --- Redis / Kafka host ports ---
REDIS_PORT=6379
KAFKA_HOST_PORT=9094

# --- Backend (host / go run). Keep user/pass in sync with POSTGRES_* above.
# Compose rebuilds DB/Redis/Kafka URLs with Docker DNS (db/redis/kafka).
# Avoid @ : / # in POSTGRES_PASSWORD — it is embedded in a URL without encoding.
DATABASE_URL=postgres://scheduler:scheduler@127.0.0.1:5432/scheduler?sslmode=disable
REDIS_URL=redis://127.0.0.1:6379/0
# true: refuse to start while Redis is unreachable. Default false: Redis only accelerates
# (idempotency replay, rate limits, WS tickets) and every use fails open.
REDIS_REQUIRED=false
KAFKA_BROKERS=127.0.0.1:9094
KAFKA_TOPIC=appointments.events
HTTP_ADDR=:8080
# Placeholder: the server refuses any secret starting with dev-only-change-me. scripts/ensure-env.sh
# (sourced by up.sh, check-all.sh, …) replaces it in .env with `openssl rand -hex 32`; by hand,
# set at least 32 random bytes.
JWT_SECRET=dev-only-change-me
INSTANCE_ID=local
SEED=true

BACKEND_1_INSTANCE_ID=backend-1
BACKEND_1_SEED=true
BACKEND_1_HOST_PORT=18081

BACKEND_2_INSTANCE_ID=backend-2
BACKEND_2_SEED=false
BACKEND_2_HOST_PORT=18082

# --- Gateway / Web / Observability host ports ---
GATEWAY_PORT=8080
WEB_PORT=8081
# Web image build: "true" ships one-click sign-in buttons for the seeded demo accounts (with their
# passwords) in the bundle. Keep it for the local demo; set false for any real deployment.
VITE_DEMO=true
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# --- Grafana ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GF_USERS_ALLOW_SIGN_UP=false
GF_AUTH_ANONYMOUS_ENABLED=true
GF_AUTH_ANONYMOUS_ORG_ROLE=Viewer

# --- Backend tuning (defaults shown) ---
# Postgres pool size per backend (2 backends share POSTGRES max_connections=300 with the tests).
DB_MAX_CONNS=20
# Per-instance cache of GET /dealerships and /service-types (0s-5s; 0s disables). A request sent
# with Cache-Control: no-cache always reads through.
CATALOG_CACHE_TTL=2s
# Per-request deadline for API handlers (503 busy when it expires). Keep it below the HTTP write
# timeout (30s), and the gateway's proxy_read_timeout (deploy/gateway/nginx.conf, 35s) above it.
REQUEST_TIMEOUT=20s
# Customer read throttles, requests/min (GET /appointments, /appointments/:id, /vehicles,
# /vehicles/:id, /dealerships, /service-types; never /auth/me): per signed-in customer, and per
# client IP. Staff are not counted.
READ_LIMIT_PER_USER=600
READ_LIMIT_PER_IP=3000
# Customer availability reads and booking writes (book, reschedule, cancel), requests/min, per
# customer and per client IP. One load generator is one IP: raise the per-IP ones to bench the
# customer path (scripts/bench.sh journey) instead of the limiter.
AVAILABILITY_LIMIT_PER_USER=120
AVAILABILITY_LIMIT_PER_IP=600
WRITE_LIMIT_PER_USER=30
WRITE_LIMIT_PER_IP=120

# --- Sessions ---
# Access token (JWT, Bearer) lifetime, 1m-1h. Browsers keep it in memory and renew it with the
# refresh cookie (POST /api/v1/auth/refresh) shortly before it expires.
ACCESS_TOKEN_TTL=15m
# Each refresh token stays usable this long after it was issued (longer than ACCESS_TOKEN_TTL);
# every refresh rotates it. A login session ends SESSION_MAX_TTL after login (at most 2160h = 90
# days, at least SESSION_IDLE_TTL), however often it is refreshed.
SESSION_IDLE_TTL=24h
SESSION_MAX_TTL=168h
# Secure refresh cookie: true (the server's default) names it __Host-uss_refresh (Secure, Path=/, no
# Domain: no subdomain or plain-http page can plant one); false names it uss_refresh on
# Path=/api/v1/auth without Secure. The server defaults to true; it is false here
# only because the local stack is plain http (http://localhost:8081 through the gateway, the Vite
# dev server): a Secure cookie is not sent back over plain http by every client (e.g. Go's
# cookiejar, browsers on a non-localhost http address). Anything served over HTTPS must keep true.
AUTH_COOKIE_SECURE=false
# POST /auth/refresh per client IP per minute (fail-open while Redis is down). One load generator
# is one IP: raise it for long stress runs whose virtual users refresh.
REFRESH_LIMIT_PER_IP=60

# --- Stress / smoke (optional) ---
# BASE_URL=http://127.0.0.1:8080
# BACKEND_A_URL=http://127.0.0.1:18081
# BACKEND_B_URL=http://127.0.0.1:18082
# Stress open-loop mode: target bookings/s measured from the intended send time (0 = closed loop).
# RATE=0
# Smoke scripts: per-request timeout (s) and the logins they use (default: the seeded demo users;
# also DISPATCHER_* and CUSTOMER_*).
# SMOKE_HTTP_TIMEOUT=30
# ADMIN_EMAIL=admin@scheduler.local
# ADMIN_PASSWORD=admin123
# check-all.sh / up.sh: seconds to wait for every healthcheck.
# WAIT_TIMEOUT=300
# Images compose tags (backend-2 reuses backend-1's build).
# BACKEND_IMAGE=unified-service-scheduler/backend:local
# WEB_IMAGE=unified-service-scheduler/web:local

# Background sweep marking confirmed appointments not checked in within their dealership's
# no-show grace (per dealership: noShowGraceMinutes, admin API) as no_show. false disables it.
NO_SHOW_SWEEP=true

# Client IP for rate limits: proxies (IPs/CIDRs, comma-separated, or "none") whose
# X-Forwarded-For / X-Real-IP the API believes; anyone else is identified by the TCP peer.
# Unset: loopback only for `go run` (127.0.0.1/32,::1/128); docker-compose defaults the backends
# to the gateway's fixed address (SCHEDULER_GATEWAY_IP, 172.28.50.10), so only the gateway is
# believed.
# TRUSTED_PROXIES=
# Browser origins allowed to open the WebSocket (comma-separated scheme://host[:port]). Unset:
# the page must be served from the same host:port the socket connects to. The refresh-cookie
# endpoints (POST /auth/refresh, /auth/logout by cookie) accept these origins besides their own.
# ALLOWED_ORIGINS=https://scheduler.example.com
