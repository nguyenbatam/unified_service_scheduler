{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP requests /s",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (instance_id, status) (rate(scheduler_http_requests_total[1m]))",
          "legendFormat": "{{instance_id}} {{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Booking results /s",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (instance_id, result) (rate(scheduler_bookings_total[1m]))",
          "legendFormat": "{{instance_id}} {{result}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP latency p95",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, instance_id) (rate(scheduler_http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "{{instance_id}} p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "WebSocket clients",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "scheduler_ws_clients",
          "legendFormat": "{{instance_id}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Go goroutines",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 5,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "go_goroutines{job=\"scheduler-backends\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Bookings created (total)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 16 },
      "id": 6,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(scheduler_bookings_total{result=\"created\"})",
          "legendFormat": "created"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Booking conflicts (total)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 16 },
      "id": 7,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(scheduler_bookings_total{result=\"conflict\"}) or vector(0)",
          "legendFormat": "conflict"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["scheduler", "keyloop"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "timezone": "browser",
  "title": "Unified Service Scheduler",
  "uid": "uss-scheduler",
  "version": 1
}
